# ==========================================
# HIDDEN DEPENDENCY X-RAY (HDX) - ENVIRONMENT
# ==========================================

# Environment Mode: development | production | test
ENVIRONMENT=development
LOG_LEVEL=info

# ------------------------------------------
# Backend Service (FastAPI) [Role B]
# ------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database (MongoDB Community)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=hdx_dependency_db

# ------------------------------------------
# Frontend Client (React + Vite) [Role C]
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_KNOWLEDGE_PLANE_URL=http://localhost:8080

# ------------------------------------------
# Knowledge Plane & Security [Role D]
# ------------------------------------------
# Mode: vault (offline/manual) | hybrid (pull signed bundles)
HDX_OPERATING_MODE=hybrid
KNOWLEDGE_PLANE_API_URL=https://knowledge.hdx-defense.io/v1

# Ed25519 Public Key for Knowledge Bundle Verification (base64 or hex)
KNOWLEDGE_BUNDLE_PUBLIC_KEY=MCowBQYDK2VwAyEAGb8...dummy_ed25519_pubkey...

# Google Gemini API (Public Vendor Enrichment)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Solana Devnet (Public Knowledge Hash Anchoring)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=HDXAnchorProgram111111111111111111111111111111
SOLANA_COMMITMENT=confirmed

# ------------------------------------------
# Sample App / Scanner Target [Role A]
# ------------------------------------------
DEMO_APP_PATH=./demo/nexus-commerce
FIXTURES_RUNTIME_PATH=./fixtures/runtime

