# ==========================================
# HDX KNOWLEDGE PLANE - ENVIRONMENT (ROLE D)
# ==========================================

# Port for Knowledge Plane distribution service
PORT=8080
HOST=0.0.0.0

# DigitalOcean Spaces Storage Configuration (Optional)
DO_SPACES_KEY=your_do_spaces_access_key
DO_SPACES_SECRET=your_do_spaces_secret_key
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=hdx-public-knowledge-bundles

# Ed25519 Signing Keypair (Never commit private key to Git)
KNOWLEDGE_ED25519_PRIVATE_KEY_HEX=
KNOWLEDGE_ED25519_PUBLIC_KEY_HEX=

# Solana Devnet (Memo Program Hash Anchoring)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=
SOLANA_COMMITMENT=confirmed

# Google Gemini API Key (Public Vendor Extraction)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

